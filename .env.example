# .env.example
# Copiar como .env y rellenar con tus valores reales

# ======== API Keys ========

# Google Places API (opcional si usas SerpAPI)
# Obtén en: https://cloud.google.com/console
GOOGLE_API_KEY=

# SerpAPI - búsqueda en Google Maps
# Obtén en: https://serpapi.com
SERPAPI_KEY=

# Serper.dev - búsqueda rápida en Google (proveedor de datos; usado por primer_contacto/auditoría)
# Obtén en: https://serper.dev (2500 búsquedas gratis)
SERPER_API_KEY=

# OpenAI API (solo si NO usas Ollama local)
OPENAI_API_KEY=

# ======== Configuración LLM ========

# Usar Ollama local (true) o OpenAI cloud (false)
USE_LOCAL_LLM=true

# URL del servidor Ollama
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Modelo a usar (rutina = Ollama local; qwen3:4b probado autónomo, 27b requiere >16GB VRAM)
LOCAL_LLM_MODEL=qwen3:4b
# Modelo ligero (fallback sin GPU) que la semilla descarga por CLI.
OLLAMA_MODELO_BASICO=qwen2.5:1.5b

# ======== Motor de auditorías (offload forzoso a obrero) ========
# Arbol que ejecuta el trabajo pesado cuando el panel inicia una auditoría.
# "local" = ejecuta aquí; cualquier arbol_id del inventario = delega allá
# (requiere llave SSH BatchMode al obrero) y trae el JSON al terminar.
AUDITORIA_MOTOR=arbol_obrero_01
# Minutos máximos esperando el reporte del obrero antes de marcar timeout.
AUDITORIA_TIMEOUT_MIN=90

# ======== OpenRouter (estrategia / razonamiento avanzado) ========
# Vacío por defecto: sembrar.sh te pedirá la key propia del árbol.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=4096

# ======== Proveedor de datos ========

# Opciones: serpapi, google, mock
# - serpapi: Más confiable, requiere API key
# - google: Google Places API nativa
# - mock: Datos ficticios (para testing)
DATA_PROVIDER=serpapi

# ======== Logging ========

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ======== Configuración adicional ========

# Encoding por defecto en Windows
PYTHONIOENCODING=utf-8

# Timeout en segundos para peticiones HTTP
HTTP_TIMEOUT=15

# ======== Identidad del árbol (instancia por cliente) ========
# Cada despliegue (cliente/sucursal) es un ÁRBOL aislado.
ARBOL_ID=cliente_01
ARBOL_NOMBRE="Cliente X"

# Red privada de la colmena (Tailscale). Auth key (genera en la consola de Tailscale).
# AnónIMO: dejar vacío = conectar manualmente con 'sudo tailscale up'.
TAILSCALE_TOKEN=
# Rol en la colmena (mente colmena):
#   obrero     → servidor vivo 24/7 (árbol hijo)
#   comandante → operaciones de marketing (micelio limitado: errores + upgrades)
#   conservante→ exclusivo del arquitecto/dev (micelio completo + estructura)
#   heredero   → comandante de respaldo (failover), conoce al primario
ARBOL_ROL=obrero
# Solo si ARBOL_ROL=heredero: host del comandante primario que sustituye.
ARBOL_HEREDERO_DE=comandante-primario.tailnet.ts.net

# === Panel del Conservante (arquitecto/dev) ===
# Token obligatorio; sin él el panel se niega (503). Define VALOR PROPIO aquí.
CONSERVANTE_WEB_TOKEN=
CONSERVANTE_WEB_PORT=8002

# === Panel del Comandante (operaciones de marketing) ===
# Si se define token, exige el header X-Comandante-Token (401 si no). Vacío = abierto en localhost.
COMANDANTE_WEB_TOKEN=
COMANDANTE_WEB_PORT=8001

# === Auto-apertura del panel en el navegador al arrancar ===
# Opt-in y SOLO local: con true, el panel abre su URL al iniciar el servidor;
# solo actúa si el host es 127.0.0.1/localhost/::1. En servidores remotos,
# docker o headless no hace nada (y por defecto viene desactivado).
AUTO_OPEN_BROWSER=false
# URL que abre Levantar Colmena.bat al terminar (solo sesión interactiva).
# Vacío = panel del árbol http://127.0.0.1:8000/. Ej. conservante: http://127.0.0.1:8002/
#LEVANTAR_URL=
# === Acceso al panel del árbol (:8000) ===
# Por arquitectura las cuentas viven en los árboles PRINCIPALES; el obrero es
# consola de operaciones y opera abierto (sin login para auditar/ver reportes).
# true/1/yes/on = abierto siempre; false/0/no/off = siempre con login.
# Vacío (auto) = abierto solo si ARBOL_ROL=obrero.
# NUNCA abre: /api/admin/*, /api/aprobaciones* (Directora) ni /api/auth/me.
#PANEL_ABIERTO=

# ======== Base de datos (colmena) ========
# Por defecto SQLite local (app_database.db). Para usar SUPABASE en la nube:
# pega la connection string Postgres de tu proyecto (Settings → Database → Connection string → URI)
# Ejemplo: DATABASE_URL=postgresql://postgres.xxx:password@aws-0-...pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///app_database.db
# Proyecto Supabase (para el SDK / MCP):
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# NOTA: la publishable key NO sirve para conectar el driver de db.py; usa DATABASE_URL (connection string con password).

# ======== Acceso web / base de datos ========
# JWT: genéralo con: python -c "import secrets;print(secrets.token_hex(32))"
# DEFINE UN VALOR PROPIO aquí (placeholder vacío deja el secreto efímero).
JWT_SECRET_KEY=

# Admin inicial (creado por db.init_db si no hay admin).
# Define ADMIN_PASSWORD aquí o se generará una contraseña temporal segura (nunca hardcodeada).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@marketing.com
ADMIN_PASSWORD=
# Directora Humana (se crea con sembrar.sh)
DIRECTORA_USERNAME=directora
DIRECTORA_EMAIL=directora@marketing.com
# DIRECTORA_PASSWORD se pide en sembrar.sh (no dejar en .env commit-eable)
