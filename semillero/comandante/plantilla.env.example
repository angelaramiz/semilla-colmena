# Semilla del Árbol COMANDANTE — directora de mercadotecnia

# === Identidad ===
ARBOL_ID=cmd_principal
ARBOL_NOMBRE="Comandante — Directora de Mercadotecnia"
ARBOL_ROL=comandante

# === Modelos ===
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:27b
USE_LOCAL_LLM=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=4096

# === Proveedores de datos ===
DATA_PROVIDER=serper

# === Red privada (Tailscale) ===
# Auth key: consola Tailscale → Settings → Keys → Generate (tag servidor)
TAILSCALE_TOKEN=tskey-auth-XXX

# === DB (Supabase / colmena) ===
DATABASE_URL=postgresql://postgres:TU_PASS@db.nyaocuuxmihifzqbpjqd.supabase.co:5432/postgres
SUPABASE_URL=https://nyaocuuxmihifzqbpjqd.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# === Panel del Comandante (operaciones) ===
COMANDANTE_WEB_TOKEN=DEFINE_AQUI
COMANDANTE_WEB_PORT=8001

# === Acceso web / JWT ===
JWT_SECRET_KEY=DEFINE_AQUI
ADMIN_USERNAME=admin
ADMIN_EMAIL=directora@marketing.com
ADMIN_PASSWORD=
DIRECTORA_USERNAME=directora
DIRECTORA_EMAIL=directora@marketing.com
# DIRECTORA_PASSWORD se pide en sembrar.sh

# === Micelio (limitado: solo errores + upgrades para el comandante) ===
# El comandante NO accede a estructura/código (403). Solo salud/versión/actualizar.